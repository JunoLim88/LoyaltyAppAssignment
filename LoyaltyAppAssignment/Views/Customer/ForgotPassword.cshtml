@model LoyaltyAppAssignment.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Forgot Password | Brew & Bean</title>

    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
</head>

<body>
    <div class="login-container">

        <!-- left cafe panel -->
        <div class="login-left">

            <div class="brand">
                <span class="brand-icon">☕</span>
                <span>BREW & BEAN</span>
            </div>

            <div class="welcome-text">
                <p class="small-title">A LITTLE HELP FOR OUR MEMBERS</p>

                <h1>
                    Forgotten<br />
                    your password?<br />
                    <em>We've got you.</em>
                </h1>

                <p class="description">
                    Don't let a forgotten password get between
                    you and your coffee rewards. We'll help you
                    get back to your account.
                </p>

                <div class="coffee-decoration">
                    <span>✦</span>
                    YOUR REWARDS AWAIT
                    <span>✦</span>
                </div>
            </div>

            <div class="left-footer">
                EST. 2026 · BREWED FOR YOU
            </div>

        </div>

        <!-- right panel -->
        <div class="login-right">

            <div class="login-box">

                <p class="form-subtitle">ACCOUNT RECOVERY</p>

                <h2>Reset your password.</h2>

                <p class="form-description">
                    We'll help you get back to your coffee journey.
                </p>

                <div id="message" class="register-message"></div>

                <!-- request otp -->
                <div id="step1">

                    <form id="otpForm">
                        @Html.AntiForgeryToken()

                        <div class="input-group">
                            <label for="PhoneNumber">
                                Registered Phone Number
                            </label>

                            <input asp-for="PhoneNumber"
                                   type="tel"
                                   placeholder="e.g. 0123456789"
                                   required />
                        </div>

                        <button type="submit"
                                class="login-btn"
                                id="otpButton">
                            Send Verification Code
                        </button>
                    </form>

                </div>

                <!-- reset password -->
                <div id="step2" style="display:none;">

                    <p class="otp-description">
                        Your verification code has been requested.
                        Check your registered email inbox.
                    </p>

                    <form id="resetForm">
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               id="ResetPhoneNumber"
                               name="PhoneNumber" />

                        <div class="input-group">
                            <label for="Otp">
                                6-Digit Verification Code
                            </label>

                            <input type="text"
                                   id="Otp"
                                   name="Otp"
                                   maxlength="6"
                                   inputmode="numeric"
                                   pattern="[0-9]{6}"
                                   placeholder="Enter your OTP"
                                   required />
                        </div>

                        <div class="input-group">
                            <label for="NewPassword">
                                New Password
                            </label>

                            <input type="password"
                                   id="NewPassword"
                                   name="NewPassword"
                                   minlength="6"
                                   placeholder="Enter your new password"
                                   required />
                        </div>

                        <div class="input-group">
                            <label for="ConfirmPassword">
                                Confirm New Password
                            </label>

                            <input type="password"
                                   id="ConfirmPassword"
                                   placeholder="Confirm your new password"
                                   required />
                        </div>

                        <button type="submit"
                                class="login-btn"
                                id="resetButton">
                            Reset Password
                        </button>
                    </form>

                    <button type="button"
                            id="backButton"
                            class="text-button">
                        Change phone number / Request another OTP
                    </button>

                </div>

                <div class="divider">
                    <span>REMEMBERED YOUR PASSWORD?</span>
                </div>

                <a asp-controller="Customer"
                   asp-action="Login"
                   class="register-btn">
                    Back to Login
                </a>

                <p class="bottom-text">
                    Every great coffee deserves a happy ending. ☕
                </p>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script>
        $(function () {

            //request otp
            $("#otpForm").submit(function (e) {
                e.preventDefault();

                $("#otpButton").prop("disabled", true);
                $("#otpButton").text("Sending...");

                $("#message").text("");

                $.ajax({
                    url: '@Url.Action("GenerateOTP", "Customer")',
                    type: "POST",
                    data: $("#otpForm").serialize(),

                    success: function (response) {
                        if (response.success) {

                            $("#message")
                                .text(response.message)
                                .removeClass("error")
                                .addClass("success");

                            $("#ResetPhoneNumber").val(
                                $("#PhoneNumber").val()
                            );

                            $("#step1").hide();
                            $("#step2").show();
                        }
                        else {
                            $("#message")
                                .text(response.message)
                                .removeClass("success")
                                .addClass("error");
                        }
                    },

                    error: function () {
                        $("#message")
                            .text("Something went wrong.")
                            .removeClass("success")
                            .addClass("error");
                    },

                    complete: function () {
                        $("#otpButton").prop("disabled", false);
                        $("#otpButton").text("Send Verification Code");
                    }
                });
            });


            //reset password
            $("#resetForm").submit(function (e) {
                e.preventDefault();

                var password = $("#NewPassword").val();
                var confirmPassword = $("#ConfirmPassword").val();

                if (password !== confirmPassword) {
                    $("#message")
                        .text("Passwords do not match.")
                        .removeClass("success")
                        .addClass("error");

                    return;
                }

                $("#resetButton").prop("disabled", true);
                $("#resetButton").text("Resetting...");

                $.ajax({
                    url: '@Url.Action("ResetPassword", "Customer")',
                    type: "POST",
                    data: $("#resetForm").serialize(),

                    success: function (response) {
                        if (response.success) {
                            $("#message")
                                .text(response.message)
                                .removeClass("error")
                                .addClass("success");

                            $("#step2").hide();

                            setTimeout(function () {
                                window.location.href =
                                    '@Url.Action("Login", "Customer")';
                            }, 1500);
                        }
                        else {
                            $("#message")
                                .text(response.message)
                                .removeClass("success")
                                .addClass("error");
                        }
                    },

                    error: function () {
                        $("#message")
                            .text("Something went wrong.")
                            .removeClass("success")
                            .addClass("error");
                    },

                    complete: function () {
                        $("#resetButton").prop("disabled", false);
                        $("#resetButton").text("Reset Password");
                    }
                });
            });


            // CHANGE PHONE / REQUEST NEW OTP
            $("#backButton").click(function () {
                $("#step2").hide();
                $("#step1").show();
                $("#message").text("");
            });

        });
    </script>
</body>
</html>
